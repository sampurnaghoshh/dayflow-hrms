# Copy to .env and adjust. .env is gitignored; this file is committed. (CLAUDE.md §8)

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_DB=dayflow
POSTGRES_USER=dayflow
POSTGRES_PASSWORD=dayflow_local_dev_only
POSTGRES_PORT=5432

# --- Application ---
DATABASE_URL=postgres://dayflow:dayflow_local_dev_only@localhost:5432/dayflow
# Must be >=32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./server/uploads

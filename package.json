{
  "name": "dayflow-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "Dayflow HRMS - leave and attendance as immutable event ledgers",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "migrate": "node db/run-migrations.js",
    "seed": "node db/run-seed.js",
    "dev": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "test": "node --test \"server/tests/**/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
